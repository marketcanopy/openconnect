diff --git a/src/server/api/connection-routes.test.ts b/src/server/api/connection-routes.test.ts
index f8f44db..9d36e1f 100644
--- a/src/server/api/connection-routes.test.ts
+++ b/src/server/api/connection-routes.test.ts
@@ -442,3 +442,67 @@ it("connects Slack using granted scopes from the nested user token response", as
   expect(connection.scopes).toEqual(["channels:read", "users:read"]);
   expect(fetcher).toHaveBeenCalledTimes(2);
 });
+
+describe("connection requests per caller (X-Connect-Owner)", () => {
+  const adminToken = "admin-secret";
+  async function owned() {
+    const { app, call } = await setup(undefined, { adminToken });
+    const as = (owner: string | undefined, path: string, body?: unknown) =>
+      app.request(path, {
+        method: body === undefined ? "GET" : "POST",
+        headers: {
+          "content-type": "application/json",
+          authorization: `Bearer ${adminToken}`,
+          ...(owner === undefined ? {} : { "x-connect-owner": owner }),
+        },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+    const startAs = async (owner: string | undefined) =>
+      (await (await as(owner, "/v1/connections/example/connect", {})).json()).data;
+    const statusAs = async (owner: string | undefined, id: string) => as(owner, `/v1/connection-requests/${id}`);
+    return { call, startAs, statusAs };
+  }
+
+  it("does not supersede another owner's request, and each owner reads only its own", async () => {
+    const { call, startAs, statusAs } = await owned();
+    const a = await startAs("org-1:user-a");
+    const b = await startAs("org-1:user-b");
+    expect((await (await statusAs("org-1:user-a", a.connectionRequestId)).json()).data.status).toBe("initiated");
+    expect((await (await statusAs("org-1:user-b", b.connectionRequestId)).json()).data.status).toBe("initiated");
+    expect((await statusAs("org-1:user-b", a.connectionRequestId)).status).toBe(404);
+    expect((await statusAs(undefined, a.connectionRequestId)).status).toBe(404);
+    expect((await call(`/oauth/callback?state=${a.stateHandle}&code=code-a`)).status).toBe(200);
+    expect((await (await statusAs("org-1:user-a", a.connectionRequestId)).json()).data.status).toBe("connected");
+    expect((await call(`/oauth/callback?state=${b.stateHandle}&code=code-b`)).status).toBe(200);
+    expect((await (await statusAs("org-1:user-b", b.connectionRequestId)).json()).data.status).toBe("connected");
+  });
+
+  it("keeps superseding one owner's own earlier request and refuses its callback", async () => {
+    const { call, startAs, statusAs } = await owned();
+    const first = await startAs("org-2:user-a");
+    await startAs("org-2:user-a");
+    expect((await (await statusAs("org-2:user-a", first.connectionRequestId)).json()).data).toMatchObject({
+      status: "failed",
+      errorCode: "request_superseded",
+    });
+    expect((await call(`/oauth/callback?state=${first.stateHandle}&code=old`)).status).toBe(400);
+  });
+
+  it("refuses a callback after the request expired", async () => {
+    vi.useFakeTimers();
+    const { call, startAs } = await owned();
+    const request = await startAs("org-3:user-a");
+    vi.setSystemTime(Date.parse(request.expiresAt));
+    expect((await call(`/oauth/callback?state=${request.stateHandle}&code=late`)).status).toBe(400);
+  });
+
+  it("keeps upstream's single owner without the header", async () => {
+    const { startAs, statusAs } = await owned();
+    const first = await startAs(undefined);
+    const second = await startAs("  ");
+    expect((await (await statusAs(undefined, first.connectionRequestId)).json()).data.errorCode).toBe(
+      "request_superseded",
+    );
+    expect((await (await statusAs(undefined, second.connectionRequestId)).json()).data.status).toBe("initiated");
+  });
+});
