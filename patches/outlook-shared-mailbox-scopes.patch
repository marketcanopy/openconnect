@@ -7,6 +7,9 @@ export const outlookProviderScopes = {
   mailReadBasic: "Mail.ReadBasic",
   mailboxSettingsRead: "MailboxSettings.Read",
   offlineAccess: "offline_access",
+  mailReadWriteShared: "Mail.ReadWrite.Shared",
+  mailSendShared: "Mail.Send.Shared",
+  userReadBasicAll: "User.ReadBasic.All",
 } as const;
 
 // Reading the mailbox — the profile, the root folders, the message list and one
@@ -30,4 +33,10 @@ export const outlookOAuthScopes: string[] = [
   outlookProviderScopes.mailSend,
   outlookProviderScopes.mailboxSettingsReadWrite,
   outlookProviderScopes.offlineAccess,
+  // Market Canopy patch: reach a shared mailbox the person holds Full Access
+  // and Send As on through the proxy (/users/{mailbox}/...), and search the
+  // directory for the mailboxes they can open. None needs administrator consent.
+  outlookProviderScopes.mailReadWriteShared,
+  outlookProviderScopes.mailSendShared,
+  outlookProviderScopes.userReadBasicAll,
 ];
